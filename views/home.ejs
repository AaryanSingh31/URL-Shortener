<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
    </style>
</head>
<body>
    <h2>URL Shortener</h2>
    <!-- locals is for storing all the data locally that is sent from backend-->
    <% if (locals.id) { %>
        <h4>URL Generated : http://localhost:4001/url/<%= id %></h4>
    <% } %>
    <form method="POST" action="/url" >
        <label for="">Enter your original URL
            <input 
            type="text" 
            placeholder="Enter URL"
            name="url"
            >
        </label>
        <button type="submit">Generate</button>
    </form>
    <div>
        <% if (locals.urls) { %>
             <table>
                <thead>
                    <th>S no.</th>
                    <th>Short ID</th>
                    <th>Redirect</th>
                    <th>Clickd</th>
                </thead>
                <tbody>
                    <% urls.forEach((url, index) => { %>
                     <tr>
                        <td><%= index+1  %></td>
                        <td><%= url.shortId %></td>
                        <td><%= url.redirectUrl %></td>
                        <td><%= url.visitHistory.length %></td>
                     </tr>
                    <% }) %>
                </tbody>
             </table>
        <% } %>
    </div>
</body>
</html>